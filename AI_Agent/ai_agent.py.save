import os, time, json
import pandas as pd
import requests
from typing import Dict, Any
from dotenv import load_dotenv

load_dotenv()

# ===============================
# 🔧 CONFIG (Controlled by .env)
# ===============================
AWS_REGION = os.getenv("AWS_REGION", "ap-southeast-2")
ATHENA_DB = os.getenv("ATHENA_DATABASE", "sroad_analytics")
ATHENA_OUTPUT = os.getenv("ATHENA_OUTPUT_LOCATION", "s3://sroad-athena-results-2/")
OLLAMA_URL = os.getenv("OLLAMA_URL", "http://localhost:11434")
OLLAMA_MODEL = os.getenv("OLLAMA_MODEL", "llama3.2")
MAX_ROWS = int(os.getenv("MAX_ROWS_RETURN", "150"))
MAX_BYTES_SCANNED = int(os.getenv("MAX_BYTES_SCANNED", str(5 * 1024 * 1024 * 1024)))  # 5 GB


import boto3
athena = boto3.client("athena", region_name=AWS_REGION)


# ===============================
# 🧠 SQL Schema Hint for LLM
# (STRICT to avoid Athena errors)
# ===============================
SQL_SCHEMA_HINT = f"""
Use ONLY Athena-compatible SQL.

VALID TIME FUNCTIONS:
- current_date
- date(order_date_parsed)
- date_add('day', -N, current_date)
- date_diff('day', date(order_date_parsed), current_date)

NEVER USE:
NOW(), DATE_SUB(), DATEADD(), TIMESTAMPDIFF(), INTERVAL, CURDATE()

TABLE: sroad_analytics.unified_orders

COLUMNS:
order_id, order_timestamp, order_date_parsed,
total_amount, payment_method, payment_status,
customer_id, category, quantity, unit_price,
discount, delivery_status, city, state, channel, source

RULES:
- Only return SELECT queries.
- Always include LIMIT {MAX_ROWS}.
- No explanations, no comments, no markdown.
"""


# ===============================
# 🔥 LLM CALL (STREAM SAFE)
# ===============================
def call_llm(prompt: str, temperature: float = 0.0) -> str:
    """
    Handles streaming JSON from Ollama.
    """
    try:
        url = f"{OLLAMA_URL}/api/generate"
        payload = {
            "model": OLLAMA_MODEL,
            "prompt": prompt,
            "temperature": temperature,
            "stream": True
        }

        r = requests.post(url, json=payload, stream=True, timeout=120)
        r.raise_for_status()

        final = ""

        for line in r.iter_lines():
            if not line:
                continue
            try:
                data = json.loads(line.decode("utf-8"))
            except:
                continue

            if "response" in data:
                final += data["response"]

        return final.strip() if final.strip() else "ERROR: Empty LLM response"
    except Exception as e:
        raise RuntimeError(f"LLM call failed: {e}")
final.striptzzz

# ===============================
# 🛡️ SQL GENERATOR (FIXES INVALID SYNTAX)
# ===============================

FORBIDDEN = ["DROP", "DELETE", "UPDATE", "INSERT", "ALTER", "GRANT", "REVOKE", "CREATE"]

def generate_sql(nl: str) -> str:
    prompt = f"""
Convert this business question into SAFE Athena SQL:

{SQL_SCHEMA_HINT}

USER QUESTION:
\"\"\"{nl}\"\"\"

Return ONLY SQL. Nothing else.
"""

    sql = call_llm(prompt, temperature=0.0).strip()
    sql = sql.split(";")[0]  # remove extra output

    # Forbidden guard
    up = sql.upper()
    for f in FORBIDDEN:
        if f in up:
            raise ValueError("Unsafe SQL detected.")

    # Auto-correct wrong functions
    corrections = {
        "NOW()": "current_date",
        "CURDATE()": "current_date",
        "DATE_SUB": "date_add",
        "DATEADD": "date_add",
        "TIMESTAMPDIFF": "date_diff",
        "DATEDIFF": "date_diff",
        "INTERVAL": ""
    }
    for bad, good in corrections.items():
        sql = sql.replace(bad, good)

    # Ensure LIMIT exists
    if "LIMIT" not in sql.upper():
        sql += f" LIMIT {MAX_ROWS}"

    return sql.strip()


# ===============================
# 🚀 ATHENA QUERY RUNNER
# ===============================
def run_athena_query(sql: str) -> pd.DataFrame:
    res = athena.start_query_execution(
        QueryString=sql,
        QueryExecutionContext={"Database": ATHENA_DB},
        ResultConfiguration={"OutputLocation": ATHENA_OUTPUT}
    )

    qid = res["QueryExecutionId"]

    # Polling
    while True:
        st = athena.get_query_execution(QueryExecutionId=qid)
        state = st["QueryExecution"]["Status"]["State"]
        if state in ["SUCCEEDED", "FAILED", "CANCELLED"]:
            break
        time.sleep(0.7)

    if state != "SUCCEEDED":
        raise RuntimeError("Athena failed.")

    # Cost guard
    stats = st["QueryExecution"].get("Statistics", {})
    if stats.get("DataScannedInBytes", 0) > MAX_BYTES_SCANNED:
        raise RuntimeError("Query too expensive — blocked.")

    # Fetch small results
    rs = athena.get_query_results(QueryExecutionId=qid, MaxResults=1000)
    cols = [c["Label"] for c in rs["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]]
    rows = []

    for r in rs["ResultSet"]["Rows"][1:]:
        rows.append([c.get("VarCharValue") for c in r["Data"]])

    df = pd.DataFrame(rows, columns=cols)

    # Convert numeric columns
    for c in df.columns:
        try:
            df[c] = pd.to_numeric(df[c])
        except:
            pass

    return df


# ===============================
# �� ANOMALY & DATE FEATURES
# ===============================
def add_time_features(df):
    if "order_date_parsed" in df.columns:
        df["order_date_parsed"] = pd.to_datetime(df["order_date_parsed"], errors="coerce")
        df["date_only"] = df["order_date_parsed"].dt.date
    return df

def detect_anomalies(series):
    s = series.dropna().astype(float)
    if len(s) == 0:
        return {}

    mean = s.mean()
    std = s.std() or 1
    z = (s - mean) / std

    anomalies = list(z[abs(z) > 2.2].index.astype(str))

    return {"mean": float(mean), "std": float(std), "anomaly_days": anomalies}


# ===============================
# 💬 BUSINESS EXPLANATION GENERATOR
# ===============================
def explain(nl, sql, sample):
    sample_json = sample.to_dict(orient="records")

    prompt = f"""
User asked: "{nl}"

SQL executed:
{sql}

Sample rows:
{json.dumps(sample_json, default=str)}

Write a SHORT business summary with:
- 2–3 sentence explanation
- 2 root causes
- 3 recommended actions
"""

    return call_llm(prompt, temperature=0.3)


# ===============================
# 🎯 MAIN AGENT
# ===============================
def handle_question(nl: str):
    sql = generate_sql(nl)
    df = run_athena_query(sql)
    df = add_time_features(df)

    explanation = explain(nl, sql, df.head(10))

    trend = {}
    if "date_only" in df.columns and "total_amount" in df.columns:
        daily = df.groupby("date_only")["total_amount"].sum()
        trend = detect_anomalies(daily)

    return {
        "sql": sql,
        "rows": len(df),
        "sample": df.head(10).to_dict(orient="records"),
        "explanation": explanation,
        "trend": trend
    }


# ===============================
# 🖥️ TERMINAL MODE
# ===============================
if __name__ == "__main__":
    print("🔥 ai_agent.py LOADED SUCCESSFULLY\n")
    print("🧠 SROAD Revenue AI Agent is running!")
    print("Ask your business questions or type 'exit' to quit.\n")

    while True:
        q = input("Q: ").strip()
        if q.lower() in ["exit", "quit"]:
            break
        if q == "":
            continue

        try:
            res = handle_question(q)
            print("\n=== SQL ===")
            print(res["sql"])
            print("\n=== SAMPLE ===")
            print(res["sample"])
            print("\n=================================================\n")
        except Exception as e:
            print("❌ Error:", e)
            print("=================================================\n")
